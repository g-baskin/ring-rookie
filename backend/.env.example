# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ringrookie

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ChatGPT/Codex OAuth
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=
CHATGPT_OAUTH_ISSUER=https://auth.openai.com
CHATGPT_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CHATGPT_OAUTH_CALLBACK_URL=http://localhost:1455/auth/callback
CHATGPT_OAUTH_APP_CALLBACK_URL=http://localhost:8000/api/v1/oauth/chatgpt/callback
# Set to 0.0.0.0 inside Docker; publish port 1455 on host loopback only.
CHATGPT_OAUTH_RELAY_HOST=127.0.0.1
CHATGPT_OAUTH_FRONTEND_URL=http://localhost:4173/dashboard/settings

# Default Admin (created on first startup if no users exist)
ADMIN_EMAIL=admin@mragame.com
ADMIN_PASSWORD=admin
ADMIN_NAME=Admin
